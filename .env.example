TOKEN=TOKEN_BOT_DISCORD
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NVIDIA_NIM_API_KEY=
LLM_FAST_TIMEOUT_SECONDS=10
LLM_STANDARD_TIMEOUT_SECONDS=20
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
SENA_OWNER_ID=

# Default membuka dashboard ke jaringan LAN agar dapat diakses device lain.
# Isi PIN untuk mengaktifkan halaman login, atau gunakan 127.0.0.1 untuk lokal saja.
SENA_WEB_HOST=0.0.0.0
SENA_WEB_PORT=8550
SENA_WEB_PIN=

# Lokasi import emoji/GIF. Kosongkan untuk default otomatis per platform.
# Windows: D:\import, Termux: ~/storage/downloads, Linux/macOS: ~/Downloads.
SENA_GIF_FOLDER=

# Expression internet GIF fallback (GIPHY API).
# Sena TIDAK mengirim teks percakapan mentah ke GIPHY; query dibentuk dari emotion+intent.
# Buat API key di GIPHY Developer Dashboard lalu isi GIPHY_API_KEY.
SENA_GIF_SEARCH_ENABLED=true
GIPHY_API_KEY=
SENA_GIPHY_RATING=g
SENA_GIPHY_LANG=id
SENA_GIF_COUNTRY=ID
SENA_GIF_SEARCH_LIMIT=8
SENA_GIF_SEARCH_TIMEOUT_SECONDS=5

# Optional local webcam -> Discord expression reactions (desktop only).
# Install: pip install -r requirements-vision.txt
# Start/stop Vision dan pilih output text channel langsung dari menu Vision / Webcam.
SENA_VISION_CAMERA_INDEX=0
SENA_VISION_CALIBRATION_SECONDS=5
SENA_VISION_COOLDOWN_SECONDS=6
SENA_VISION_MODEL_DIR=models/vision
SENA_VISION_CALIBRATION_FILE=data/vision_calibration.json

# Optional performance overrides.
# Defaults are automatic:
# Android/Termux -> concurrency=2, history=2400 chars, memory=2 items/1000 chars.
# Desktop        -> concurrency=4, history=7000 chars, memory=5 items/2500 chars.
#
# Increase these only when you need more context and accept extra prompt latency.
# SENA_LLM_CONCURRENCY=2
# SENA_HISTORY_CONTEXT_MAX_CHARS=2400
# SENA_MEMORY_RETRIEVE_LIMIT=2
# SENA_MEMORY_CONTEXT_MAX_CHARS=1000

# Tiered model routing. FAST dan STANDARD memakai provider/model aktif jika
# variabelnya dikosongkan. COMPLEX memakai Kimi K3 di NVIDIA NIM.
LLM_ROUTING_ENABLED=true
LLM_JSON_PREFILL_ENABLED=true
LLM_PROMPT_CACHE_ENABLED=true
LLM_FAST_PROVIDER=
LLM_FAST_MODEL=
LLM_STANDARD_PROVIDER=
LLM_STANDARD_MODEL=
LLM_COMPLEX_PROVIDER=nvidia_nim
LLM_COMPLEX_MODEL=moonshotai/kimi-k3
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=openai/gpt-4o-mini

# Kimi K3 latency controls. Default sengaja lebih ringan daripada konfigurasi lama
# (reasoning=max, min 4096 tokens) agar soal kompleks pendek tidak gampang timeout.
SENA_KIMI_REASONING_EFFORT=high
SENA_KIMI_MIN_MAX_TOKENS=2048
