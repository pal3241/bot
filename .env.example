TOKEN=TOKEN_BOT_DISCORD
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
SENA_OWNER_ID=

# Dashboard aman secara default hanya dapat dibuka dari device yang menjalankan
# Senna. Untuk akses dari LAN, ubah host dan WAJIB isi PIN.
SENA_WEB_HOST=127.0.0.1
SENA_WEB_PORT=8550
SENA_WEB_PIN=

# Lokasi import emoji/GIF. Kosongkan untuk default otomatis per platform.
# Windows: D:\import, Termux: ~/storage/downloads, Linux/macOS: ~/Downloads.
SENA_GIF_FOLDER=

# Optional performance overrides.
# Defaults are automatic:
# Android/Termux -> concurrency=2, history=2400 chars, memory=2 items/1000 chars.
# Desktop        -> concurrency=4, history=7000 chars, memory=5 items/2500 chars.
#
# Increase these only when you need more context and accept extra prompt latency.
# SENA_LLM_CONCURRENCY=2
# SENA_HISTORY_CONTEXT_MAX_CHARS=2400
# SENA_MEMORY_RETRIEVE_LIMIT=2
# SENA_MEMORY_CONTEXT_MAX_CHARS=1000

# Tiered model routing. FAST dan STANDARD memakai provider/model aktif jika
# variabelnya dikosongkan. COMPLEX memakai Kimi K3 di NVIDIA NIM.
LLM_ROUTING_ENABLED=true
LLM_JSON_PREFILL_ENABLED=true
LLM_PROMPT_CACHE_ENABLED=true
LLM_FAST_PROVIDER=
LLM_FAST_MODEL=
LLM_STANDARD_PROVIDER=
LLM_STANDARD_MODEL=
LLM_COMPLEX_PROVIDER=nvidia_nim
LLM_COMPLEX_MODEL=moonshotai/kimi-k3
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
